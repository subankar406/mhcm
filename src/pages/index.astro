---
import { getCollection } from "astro:content";
import Layout from "@/layouts/BaseLayout.astro";
import Section from "@/components/wrapper/Section.astro";
import HeroHome from "@/components/section/HeroHome.astro";
import ProjectsHome from "@/components/section/ProjectsHome.astro";
import StatsRow from "@/components/content/StatsRow.astro";
import heroImage from "@/assets/home/hero-home.png";

const stats = {
  stat1: { number: 25, unit: "+", details: "Years in Business" },
  stat2: { number: 300, unit: "+", details: "Projects Completed" },
  stat3: { number: 8, details: "Counties Served" },
  stat4: { number: 6, details: "Industries Served" },
  stat5: { number: 100, unit: "%", details: "Self-perform Site Division" },
};

const projects = (await getCollection("projects"))
  .sort((a, b) => a.data.order - b.data.order)
  .map((project) => ({
    title: project.data.title,
    location: project.data.location,
    image: project.data.mainImage,
    href: `/project/${project.id}`,
  }));
---

<Layout
  title="Home"
  description="Mid Hudson Construction Management provides construction management, general contracting, sitework, and pre-construction services throughout New York's Hudson Valley."
  overlap={true}
>
  <!-- hero -->
  <HeroHome
    heading="Building Better Projects Through Planning, Communication, and Execution."
    image={heroImage}
  />
  <!-- stats -->
  <Section paddingTop="none" paddingBottom="none">
    <StatsRow {...stats} />
  </Section>
  <!-- projects -->
  <ProjectsHome
    heading="Projects That Reflect Our Commitment to Quality"
    text="From healthcare and education facilities to municipal infrastructure and commercial developments, MHCM delivers projects that strengthen communities and create lasting value."
    projects={projects}
  />
</Layout>
