---
import type { HTMLAttributes } from "astro/types";
import Heading from "@/components/typography/Heading.astro";
import Paragraph from "@/components/typography/Paragraph.astro";
import Img from "@/components/media/Img.astro";
import Icon from "@/components/media/Icon.astro";
import arrow from "@/assets/icons/arrow-full.svg";

interface Props extends HTMLAttributes<"a"> {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Project name. */
  title: string;
  /** Town and state. */
  location: string;
  /** Card image. */
  image: ImageMetadata;
  /** Project page. */
  href: string;
}

const {
  render = true,
  title,
  location,
  image,
  href,
  class: className,
  ...rest
} = Astro.props;
---

{
  render && title && (
    <a class:list={["project-card_wrap", className]} href={href} {...rest}>
      <div class="project-card_visual">
        <Img class="project-card_image" src={image} alt="" />
        <div class="project-card_scrim" />
        <Heading tag="h3" class="project-card_title">
          {title}
        </Heading>
      </div>
      <div class="project-card_meta">
        <Paragraph variant="large" class="project-card_location">
          {location}
        </Paragraph>
        <span class="project-card_action">
          More About The Project
          <Icon src={arrow} variant="small" />
        </span>
      </div>
    </a>
  )
}

<style is:global>
  @layer components {
    .project-card_wrap {
      display: flex;
      flex-direction: column;
      gap: var(--space-4);
      color: var(--text);

      .project-card_visual {
        position: relative;
        display: flex;
        align-items: flex-end;
        padding: var(--space-6);
        aspect-ratio: 624 / 367;
        overflow: clip;
      }
      .project-card_image,
      .project-card_scrim {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        pointer-events: none;
      }
      .project-card_image {
        object-fit: cover;
        transition: scale calc(var(--hover-duration) * 2) var(--hover-ease);
      }
      .project-card_scrim {
        background-color: var(--dark-900);
        opacity: 0.4;
      }
      .project-card_title {
        position: relative;
        z-index: 1;
      }
      .project-card_meta {
        display: flex;
        flex-flow: wrap;
        align-items: center;
        justify-content: space-between;
        gap: var(--space-4);
      }
      .project-card_action {
        display: inline-flex;
        align-items: center;
        gap: var(--space-2);
        font-size: var(--text-main);
        font-weight: var(--primary-medium);
      }
      .project-card_action .icon {
        transition: translate var(--hover-duration) var(--hover-ease);
      }
      @media (hover: hover) {
        &:hover {
          .project-card_image {
            scale: 1.04;
          }
          .project-card_action .icon {
            translate: 0.25em 0;
          }
        }
      }
    }
  }
</style>
