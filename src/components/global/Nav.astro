---
import Img from "@/components/media/Img.astro";
import NavLink from "@/components/global/NavLink.astro";
import logo from "@/assets/logo/mhcm-logo.png";
import { SITE_NAME } from "@/consts.ts";

interface Props {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** Fix the nav over the page. */
  overlap?: boolean;
}

const { render = true, overlap = false } = Astro.props;
---

{
  render && (
    <header class:list={["nav_wrap", overlap && "overlap"]}>
      <div class="nav_inner">
        <a class="nav_logo" href="/" aria-label={SITE_NAME}>
          <Img
            src={logo}
            variant="densities"
            width={176}
            transparent={true}
            loading="eager"
            fetchPriority="high"
          />
        </a>
        <button
          class="nav_toggle"
          type="button"
          aria-label="Menu"
          aria-expanded="false"
          aria-controls="nav-menu"
        >
          <span class="nav_toggle_icon" />
        </button>
        <nav class="nav_menu" id="nav-menu" aria-label="Main">
          <div class="nav_menu_inner">
            <ul class="nav_links">
              <NavLink href="/services">Services</NavLink>
              <NavLink href="/industries">Industries</NavLink>
              <NavLink href="/projects">Projects</NavLink>
              <NavLink href="/about">About</NavLink>
              <NavLink href="/careers">Careers</NavLink>
              <NavLink href="/resources">Resources</NavLink>
              <NavLink href="/contact">Contact</NavLink>
            </ul>
          </div>
        </nav>
      </div>
    </header>
  )
}

{/* No-JS fallback */}
<noscript>
  <style>
    .nav_toggle {
      display: none;
    }
    .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }
    .nav_menu_inner {
      opacity: 1;
    }
  </style>
</noscript>

<script>
  const nav = document.querySelector<HTMLElement>(".nav_wrap");
  const toggle = nav?.querySelector<HTMLButtonElement>(".nav_toggle");

  if (nav && toggle) {
    const setOpen = (open: boolean) => {
      nav.classList.toggle("open", open);
      toggle.setAttribute("aria-expanded", String(open));
    };

    toggle.addEventListener("click", () => {
      setOpen(toggle.getAttribute("aria-expanded") !== "true");
    });

    nav.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => setOpen(false));
    });

    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("open")) {
        setOpen(false);
        toggle.focus();
      }
    });

    document.addEventListener("click", (event) => {
      const target = event.target;
      if (!nav.classList.contains("open") || !(target instanceof Node)) return;
      if (!nav.contains(target)) setOpen(false);
    });

    window
      .matchMedia("(width >= 64rem)")
      .addEventListener("change", (event) => {
        if (event.matches) setOpen(false);
      });
  }
</script>

<style is:global>
  @layer components {
    .nav_wrap {
      position: sticky;
      top: 0;
      z-index: 100;
      display: flex;
      justify-content: center;
      padding-inline: var(--site-margin);
      background-color: var(--nav-background);
      backdrop-filter: blur(var(--nav-blur));
      color: var(--nav-text);

      &.overlap {
        position: fixed;
        inset-inline: 0;
      }
    }

    .nav_inner {
      width: 100%;
      max-width: var(--max-width-main);
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 0 var(--space-6);
    }

    /* Bar height */
    .nav_logo,
    .nav_toggle {
      min-height: var(--nav-height);
    }

    .nav_logo {
      display: flex;
      align-items: center;
      width: 11rem;
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.7;
        }
      }
    }

    .nav_toggle {
      --_icon-width: 1.5rem;
      --_bar-gap: 0.5rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-width: 2.75rem;
      margin-right: calc((2.75rem - var(--_icon-width)) / -2);
      color: inherit;
      border-radius: var(--radius-small);
      transition: opacity var(--hover-duration) var(--hover-ease);
      @media (hover: hover) {
        &:hover {
          opacity: 0.7;
        }
      }
    }

    .nav_toggle_icon {
      position: relative;
      display: block;
      width: var(--_icon-width);
      height: calc(var(--_bar-gap) + var(--border-width));
      &::before,
      &::after {
        content: "";
        position: absolute;
        inset-inline: 0;
        height: var(--border-width);
        background-color: currentcolor;
        transition: transform var(--open-duration) var(--open-ease);
      }
      &::before {
        top: 0;
      }
      &::after {
        top: var(--_bar-gap);
      }
    }

    .nav_wrap.open .nav_toggle_icon {
      &::before {
        transform: translateY(calc(var(--_bar-gap) / 2)) rotate(45deg);
      }
      &::after {
        transform: translateY(calc(var(--_bar-gap) / -2)) rotate(-45deg);
      }
    }

    .nav_menu {
      position: absolute;
      top: 100%;
      inset-inline: 0;
      display: grid;
      grid-template-rows: 0fr;
      visibility: hidden;
      max-height: calc(100svh - var(--nav-height));
      overflow-x: clip;
      overflow-y: auto;
      overscroll-behavior: contain;
      background-color: var(--nav-background);
      backdrop-filter: blur(var(--nav-blur));
      transition:
        grid-template-rows var(--open-duration) var(--open-ease),
        visibility var(--open-duration) var(--open-ease);
    }

    .nav_menu_inner {
      overflow: hidden;
      opacity: 0;
      transition: opacity var(--open-duration) var(--open-ease);
    }

    .nav_wrap.open .nav_menu {
      grid-template-rows: 1fr;
      visibility: visible;
    }

    .nav_wrap.open .nav_menu_inner {
      opacity: 1;
      overflow-y: auto;
    }

    .nav_links {
      display: flex;
      flex-direction: column;
      padding: var(--space-2) var(--site-margin) var(--space-4);
      font-size: var(--text-main);
      font-weight: var(--primary-regular);
      line-height: var(--line-height-large);
      & > li + li {
        border-top: var(--border-width) solid
          color-mix(in lab, currentcolor 20%, transparent);
      }
    }

    .nav_link {
      display: block;
      padding-block: var(--space-3);
      color: var(--nav-text);
      text-decoration: none;
      text-underline-offset: 0.4em;
      text-decoration-thickness: var(--border-width);
      transition: color var(--hover-duration) var(--hover-ease);
      &[aria-current="page"] {
        text-decoration: underline;
      }
      @media (hover: hover) {
        &:hover {
          color: var(--nav-text-hover);
        }
      }
    }

    @media (width >= 64rem) {
      .nav_toggle {
        display: none;
      }

      .nav_menu {
        position: static;
        display: block;
        visibility: visible;
        background-color: transparent;
        backdrop-filter: none;
      }

      .nav_menu_inner {
        overflow: visible;
        opacity: 1;
      }

      .nav_links {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        padding: 0;
        margin-right: calc(var(--space-4) * -1);
        & > li + li {
          border-top: 0;
        }
      }

      .nav_link {
        padding-block: 0;
        padding-inline: var(--space-4);
      }
    }
  }
</style>
