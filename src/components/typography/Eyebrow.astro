---
import type { HTMLAttributes } from "astro/types";
import { slotContent } from "@/utils/slots.ts";

type EyebrowVariant =
  "default" | "gray" | "whitesmoke" | "whitesmoke-wide" | "white" | "tag";

type Props = HTMLAttributes<"div"> & {
  /** Set to `false` to omit the component. */
  render?: boolean;
  /** HTML element. */
  tag?: "span" | "p" | "h1" | "h2" | "h3" | "h4" | "h5" | "h6";
  /** Eyebrow style. `default` takes its color from the theme. */
  variant?: EyebrowVariant;
};

const {
  render = true,
  tag: Tag = "p",
  variant = "default",
  class: className,
  ...rest
} = Astro.props;

const content = await slotContent(Astro.slots);
---

{
  render && content && (
    <div
      class:list={["eyebrow_wrap", variant !== "default" && variant, className]}
      {...rest}
    >
      <Tag class="eyebrow_text text-style-small">
        <Fragment set:html={content} />
      </Tag>
    </div>
  )
}

<style is:global>
  @layer components {
    .eyebrow_wrap {
      display: inline-flex;
      align-items: center;
      justify-content: var(--_alignment, start);
      gap: var(--space-2);
      color: var(--eyebrow-text);

      .eyebrow_text {
        font-family: var(--eyebrow-family);
        font-weight: var(--primary-semibold);
        letter-spacing: var(--_tracking, var(--letter-spacing-wide));
        text-transform: uppercase;
      }
      &.gray {
        color: var(--neutral-500);
      }
      &.whitesmoke {
        color: var(--light-300);
      }
      &.whitesmoke-wide {
        color: var(--light-300);
        --_tracking: var(--letter-spacing-widest);
      }
      &.white {
        color: var(--light-100);
      }
      &.tag {
        background-color: var(--text);
        color: var(--background);
        padding: var(--space-2) var(--space-3);
        border-radius: var(--radius-small);
      }
    }
  }
</style>
